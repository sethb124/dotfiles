#!/bin/sh
main='#C50ED2'
text='#EBFAFA'
bg='#000000'
exec bemenu -ciwC -B 2 -W 0.4 -l 26 --single-instance \
    --fn 'FiraCode Nerd Font 10' \
    --bdr $main --tf $main --hf $main \
    --ff $text --cf $text --nf $text --af $text \
    --tb $bg --fb $bg --cb $bg --nb $bg --hb $bg --ab $bg \
    "$@"
